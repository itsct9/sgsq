{"title":"SSC MTS 2022 Books-authors PART-1","slug":"ssc-mts-2022-books-authors-part-1","questions":[{"question":"Who wrote the book \"A Brief History of Time\"?","option_1":"Neil Degrasse Tyson","option_2":"John Watson","option_3":"Albert Einstein","option_4":"Stephen Hawking","answer":"4","solution":""},{"question":"Who is the author of the book titled ‘Fearless Governance’?","option_1":"Amitav Ghosh","option_2":"Kiran Bedi","option_3":"Anirudh Suri","option_4":"Anuj Dhar","answer":"2","solution":""},{"question":"Who wrote book named “Gulamgiri” in 1873?","option_1":"Jyotiba Phule","option_2":"Dayanand Saraswati","option_3":"Ishwarchandra Vidyasagar","option_4":"Debendranath Tagore","answer":"1","solution":""},{"question":"Which among the following books was written by Dr. Raghuram Rajan?","option_1":"The India Story","option_2":"My Life in Full","option_3":"The Third Pillar","option_4":"We are Displaced","answer":"3","solution":""},{"question":"Which among the following books is an autobiography of Mithali Raj?","option_1":"All Round View","option_2":"Unguarded","option_3":"No Holding Back","option_4":"One More Over","answer":"2","solution":""},{"question":"Which of the following book is the autobiography of Dalai Lama?","option_1":"Touch Play","option_2":"Freedom in Exile","option_3":"Playing It My Way","option_4":"Red Sari","answer":"2","solution":""},{"question":"‘The Stars in My Sky: Those Who Brightened My Film Journey” is the second book of________.","option_1":"Divya Dutta","option_2":"Neeti Mohan","option_3":"Amitabh Bachchan","option_4":"Sonam Kapoor","answer":"1","solution":""},{"question":"Which of the following books is authored by Indu Sundaresan?","option_1":"The Secret of the Nagas","option_2":"The Feast of Roses","option_3":"The One You Cannot Have","option_4":"Ajaya: Rise of Kali","answer":"2","solution":""},{"question":"Which of the following books was written by Swami Vivekananda?","option_1":"Ancient India","option_2":"River of Smoke","option_3":"The East and the West","option_4":"No secrets","answer":"3","solution":""},{"question":"‘Freedom in Exile’ is the autobiographical book of_________.","option_1":"Dalai Lama","option_2":"Jawaharlal Nehru","option_3":"J.B. Kriplani","option_4":"Mahatma Gandhi","answer":"1","solution":""},{"question":"Which among the following book was NOT written by King Harshavardhana?","option_1":"Nagananda","option_2":"Ratnavali","option_3":"Amuktamalayada","option_4":"Priyadarsika","answer":"3","solution":""},{"question":"In The Afternoon of Time’ is an autobiographical book by _______.","option_1":"PT. Usha","option_2":"Harivansh Rai Bachchan","option_3":"Sam Pitroda","option_4":"Satyajit Ray","answer":"2","solution":""},{"question":"______ describe the idea of evolution in his book, “The origin of species™.","option_1":"Charles Darwin","option_2":"Robert Brown","option_3":"Edward Jenner","option_4":"Aristotle","answer":"1","solution":""},{"question":"‘Ace against Odds’ is an autobiographical book by _______ .","option_1":"V.V. Giri","option_2":"Mary Kom","option_3":"Sania Mirza","option_4":"Sachin Tendulkar","answer":"3","solution":""},{"question":"Who among the following is the author of the book \"An Autobiography: Toward Freedom\"?","option_1":"Mahatma Gandhi","option_2":"Jawaharlal Nehru","option_3":"Lala Lajpat Rai","option_4":"Indira Gandhi","answer":"2","solution":""},{"question":"The Inheritance of Loss’ book is written by __________.","option_1":"VS Naipaul","option_2":"Ruskin Bond","option_3":"Kiran Desai","option_4":"Salman Rushdie","answer":"3","solution":""},{"question":"Which of the following book is the autobiography of Milkha Singh?","option_1":"Romancing My Life","option_2":"The Race of My Life","option_3":"Two Lives","option_4":"Touch Play","answer":"2","solution":""},{"question":"Which among the following books released in 2021 was written by Amartya Sen?","option_1":"Home in the World","option_2":"Skill It, Kill It","option_3":"Will","option_4":"It's a Wonderful Life","answer":"1","solution":""},{"question":"Who is the author of the book titled ‘The White Tiger?","option_1":"Ravinder Singh","option_2":"Khushwant Singh","option_3":"Aravind Adiga","option_4":"Mulk Raj Anand","answer":"3","solution":""},{"question":"Which of the following books is written by Mulk Raj Anand?","option_1":"The Blue Umbrella","option_2":"The English Teacher","option_3":"A Suitable Boy","option_4":"Untouchable","answer":"4","solution":""},{"question":"\"Wide Angle\" is an autobiography of which of the following sportsperson?","option_1":"Anil Kumble","option_2":"Wasim Akram","option_3":"Imran Khan","option_4":"Yuvraj Singh","answer":"1","solution":""},{"question":"Long Walk to Freedom’ is an autobiography of ________.","option_1":"Mahatma Gandhi","option_2":"Benjamin Franklin","option_3":"Jawaharlal Nehru","option_4":"Nelson Mandela","answer":"4","solution":""},{"question":"\"And then One Day: A Memoir\" is an autobiography of which of the following Bollywood star?","option_1":"Naseeruddin Shah","option_2":"Shahrukh Khan","option_3":"Karan Johar","option_4":"Priyanka Chopra","answer":"1","solution":""},{"question":"\"Playing It My Way\" is an autobiography of _______.","option_1":"Yuvraj Singh","option_2":"Rahul Dravid","option_3":"MS Dhoni","option_4":"Sachin Tendulkar","answer":"4","solution":""},{"question":"‘Golden Girl’ is the autobiography of _____________","option_1":"PT. Usha","option_2":"Saina Nehwal","option_3":"Divya Dutta","option_4":"Neena Gupta","answer":"1","solution":""}]}